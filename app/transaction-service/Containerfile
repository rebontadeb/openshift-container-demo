FROM python:3.11-slim

WORKDIR /app

RUN addgroup --gid 1001 appgroup && \
    adduser  --uid 1001 --gid 1001 --no-create-home --disabled-password appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

USER 1001

EXPOSE 8080

# Single worker (with threads for concurrency) so prometheus_client's
# in-memory Histogram/Counter registry is shared across every request —
# with 2+ workers, each is a separate process with its own registry, and
# whichever worker happens to serve the /metrics scrape won't see
# observations recorded by a different worker. No multiprocess mode is
# configured (no PROMETHEUS_MULTIPROC_DIR / MultiProcessCollector), so
# multi-worker here means metrics are unreliable, not just imprecise.
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "30", "app:app"]
