FROM python:3.11-slim

WORKDIR /app

RUN addgroup --gid 1001 appgroup && \
    adduser  --uid 1001 --gid 1001 --no-create-home --disabled-password appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .
COPY gunicorn.conf.py .

# PROMETHEUS_MULTIPROC_DIR + gunicorn.conf.py's on_starting/child_exit hooks
# put prometheus_client into multiprocess mode — see transaction-service's
# Containerfile for the full explanation.
ENV PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

USER 1001

EXPOSE 8080

CMD ["gunicorn", "-c", "gunicorn.conf.py", "--bind", "0.0.0.0:8080", "--workers", "2", "--threads", "4", "--timeout", "30", "app:app"]
