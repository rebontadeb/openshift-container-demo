FROM python:3.11-slim

WORKDIR /app

RUN addgroup --gid 1001 appgroup && \
    adduser  --uid 1001 --gid 1001 --no-create-home --disabled-password appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

USER 1001

EXPOSE 8080

# Single worker (with threads for concurrency) — see transaction-service's
# Containerfile for why: prometheus_client's in-memory registry isn't
# shared across gunicorn workers without multiprocess mode, which isn't
# configured here.
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "30", "app:app"]
